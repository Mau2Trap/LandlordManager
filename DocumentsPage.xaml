<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:LandlordManager.Models"
             x:Class="LandlordManager.DocumentsPage"
             Title="Documents"
             BackgroundColor="#f4f6f8">

    <Grid RowDefinitions="*, Auto" Padding="20">

        <Label x:Name="lblEmpty" 
               Text="No documents yet. Tap upload to start." 
               TextColor="Gray" 
               HorizontalOptions="Center" 
               VerticalOptions="Center"
               IsVisible="False"/>

        <CollectionView x:Name="cvDocuments" Grid.Row="0">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="15" VerticalItemSpacing="15"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Document">
                    <Frame Padding="10" CornerRadius="12" BackgroundColor="White" HasShadow="True" BorderColor="Transparent">
                        <StackLayout Spacing="5">
                            <BoxView Color="{Binding FileType, Converter={StaticResource FileColorConverter}}" 
                                     HeightRequest="80" 
                                     WidthRequest="80" 
                                     CornerRadius="8" 
                                     HorizontalOptions="Center"/>

                            <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" LineBreakMode="TailTruncation"/>
                            <Label Text="{Binding UploadDate, StringFormat='{0:MMM dd, yyyy}'}" FontSize="10" TextColor="Gray" HorizontalOptions="Center"/>
                        </StackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDocumentTapped" CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" 
                Text="+ Upload Document" 
                BackgroundColor="#0f172a" 
                TextColor="White" 
                HeightRequest="50" 
                CornerRadius="25" 
                Clicked="OnUploadClicked" 
                Margin="0,10"/>
    </Grid>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="BoxView">
                <Setter Property="Color" Value="#e2e8f0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

</ContentPage>