<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:LandlordManager.Models"
             x:Class="LandlordManager.DocumentsPage"
             Title="Documents"
             BackgroundColor="#f4f6f8">

    <Grid RowDefinitions="*, Auto" Padding="15">
        <CollectionView x:Name="cvDocuments" Grid.Row="0">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Document">
                    <Frame Padding="10" CornerRadius="10" BackgroundColor="White" HasShadow="True">
                        <StackLayout>
                            <BoxView Color="#e2e8f0" HeightRequest="80" WidthRequest="80" HorizontalOptions="Center" CornerRadius="5"/>
                            <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            <Label Text="{Binding UploadDate, StringFormat='{0:MMM dd}'}" FontSize="10" TextColor="Gray" HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="Upload Document" BackgroundColor="#0f172a" TextColor="White" HeightRequest="50" CornerRadius="25" Clicked="OnUploadClicked" Margin="0,10"/>
    </Grid>
</ContentPage>