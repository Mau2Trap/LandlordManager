<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LandlordManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LandlordManager"
    Shell.FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="#0f172a">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="120" BackgroundColor="#0f172a" Padding="20">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="RENTALYST" 
                       TextColor="White" 
                       FontSize="24" 
                       FontAttributes="Bold"/>
                <Label Text="Property Manager" 
                       TextColor="#94a3b8" 
                       FontSize="14"/>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Dashboard" Icon="dashboard_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Properties" Icon="house_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:PropertiesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Tenants" Icon="people_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:TenantsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Documents" Icon="folder_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:DocumentsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Repairs" Icon="hammer_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:RepairsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Financials" Icon="dollar_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:FinancialsPage}" />
    </FlyoutItem>

    <MenuItem Text="Sign Out" IconImageSource="logout_icon.png"/>

</Shell>