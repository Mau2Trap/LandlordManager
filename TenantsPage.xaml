<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:LandlordManager.Models"
             x:Class="LandlordManager.TenantsPage"
             Title="Tenants"
             BackgroundColor="#f4f6f8">

    <Grid RowDefinitions="*, Auto" Padding="15">
        <CollectionView x:Name="cvTenants" SelectionMode="Single" SelectionChanged="OnTenantSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Tenant">
                    <Frame Margin="0,5" Padding="15" CornerRadius="12" BackgroundColor="White" HasShadow="True">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackLayout Grid.Column="0">
                                <Label Text="{Binding FullName}" FontSize="18" FontAttributes="Bold" TextColor="#0f172a"/>
                                <Label Text="{Binding PhoneNumber}" FontSize="14" TextColor="Gray"/>
                            </StackLayout>
                            <Button Grid.Column="1" Text="Chat" BackgroundColor="#059669" TextColor="White" HeightRequest="40" CornerRadius="20" WidthRequest="80"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="+ Add Tenant" BackgroundColor="#0f172a" TextColor="White" HeightRequest="50" CornerRadius="25" Clicked="OnAddTenantClicked" Margin="0,10"/>
    </Grid>
</ContentPage>